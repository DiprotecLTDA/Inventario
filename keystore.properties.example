# Plantilla de configuración de firma.
# Copia este archivo como "keystore.properties" (NO se versiona) y completa tus valores.
# Sin este archivo, las builds de release se generan sin firmar.
storeFile=/ruta/absoluta/a/tu/keystore.jks
storePassword=TU_STORE_PASSWORD
keyAlias=TU_ALIAS
keyPassword=TU_KEY_PASSWORD
